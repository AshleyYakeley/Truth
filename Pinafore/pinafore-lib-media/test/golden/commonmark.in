#!/usr/bin/env pinafore1
import "media"
let {
    showCM: Text -> Action Unit
    = fn text => do {
        outputLn.Env "- PLAIN";
        outputLn.Env $ show $ toHTML.CommonMarkText $ Mk.CommonMarkText text;
        outputLn.Env "- LIVE";
        toHTMLModel.CommonMarkText (Mk.CommonMarkText text) >- fn {
            Failure.Result r => outputLn.Env "FAIL";
            Success.Result model => do {
                htmlText <- get model;
                outputLn.Env $ show htmlText;
            };
        };
    };
}
do {
    showCM "hello";
    showCM "# H1";
    showCM "This *emphasised* word.";
    showCM "p q r @` ap{pure \"34\"} ` x y z";
    showCM "p q r @`` ap{pure \"34\"} `` x y z";
    showCM "p q r @`ap{pure \"34\"}` x y z";
    showCM "p q r @``ap{pure \"34\"}`` x y z";
    pure ();
}
