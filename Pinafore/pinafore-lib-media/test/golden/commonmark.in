#!/usr/bin/env pinafore1
import "media"
let {
    mkModel: Text -> Action (WholeModel HTMLText)
    = fn text =>
    with Pinafore. do {
        rmodel <- run.Interpreter !{this.Context} $ do.Interpreter {
            media <- interpret.Scope "import \"media\"";
            apply.Scope media $ do.Interpreter {
                val <- interpret.Value text;
                unify.Value !{this.Scope} @(WholeModel HTMLText) val;
            }
        };
        rmodel
    };

    showCM: Text -> Action Unit
    = fn text => do {
        outputLn.Env "- PLAIN";
        outputLn.Env $ show $ toHTML.CommonMarkText $ Mk.CommonMarkText text;
        outputLn.Env "- LIVE";
        model <- toHTMLModel.CommonMarkText mkModel $ Mk.CommonMarkText text;
        htmlText <- get model;
        outputLn.Env $ show htmlText;
    };
}
do {
    showCM "hello";
    showCM "# H1";
    showCM "This *emphasised* word.";
    showCM "p q r @` ap{Mk.HTMLText \"34\"} ` x y z";
    showCM "p q r @`` ap{Mk.HTMLText \"34\"} `` x y z";
    showCM "p q r @`ap{Mk.HTMLText \"34\"}` x y z";
    showCM "p q r @``ap{Mk.HTMLText \"34\"}`` x y z";
    showCM "p q r @```ap{Mk.HTMLText \"34\"}``` x y z";
    showCM "p q r @``ap{Mk.HTMLText \"`\"}`` x y z";
    showCM "p q r @```ap{Mk.HTMLText $ \"``\" <>.Text \"`\"}``` x y z";
    pure ();
}
