#!/usr/bin/env pinafore1
import "media", "gnome"
with GTK.
run $
fn gtk =>
let {
    openLinkWindow: Text -> Action Unit =
        fn path => do {
            contentsRef <- newMem.WholeModel;
            contentsRef := path;
            open.Window gtk (200,200) ap{"Empty"} $ textView.Widget $ fromWhole.TextModel contentsRef;
            pure ();
        };
    linkClicked: URI -> Maybe (Action Unit) =
        fn Mk.URI => scheme >- fn {
            Just "sch" => Just $ openLinkWindow path;
            _ => Nothing;
        }
}
do {
    r <- newMem.WholeModel;
    r := "<a href=\"sch:pqr\">link</a>";
        open.Window gtk (400,600) ap{"WebKit"} $
        notebook.Widget unknown.WholeModel [
            (label.Widget ap{"HTML Text"},scrolled.Widget $ textView.Widget $ fromWhole.TextModel r),
            (label.Widget ap{"Rendered"},webView.WebKit {onLinkClicked = linkClicked;} ap{Mk.HTMLText %r})
        ];
}
