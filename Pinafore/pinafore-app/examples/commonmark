#!/usr/bin/env pinafore1
import "media", "gnome"
with GTK.
do {
    cmRef <- newMem.WholeModel;
    htmlErr: Showable -> HTMLText =
        fn err => with HTMLText tag "em" $ plain "error: " <> plain (show err);
    htmlRef: WholeModel +HTMLText =
        ap{from.Result htmlErr id $ toHTML.CommonMarkText %cmRef};
    cmWidget: Widget.GTK =
        scrolled.Widget $
        textView.Widget $
        fromWhole.TextModel $
        asText.CommonMarkText !$ cmRef;
    htmlWidget: Widget.GTK =
        scrolled.Widget $
        textView.Widget $
        fromWhole.TextModel ap{%htmlRef >- fn Mk.HTMLText t => t};
    webWidget: Widget.GTK =
        webView.WebKit htmlRef;
    run $
        fn gtk =>
        open.Window gtk (400,600) ap{"CommonMark / WebKit"} $
        notebook.Widget unknown.WholeModel [
            (label.Widget ap{"CommonMark Text"}, cmWidget),
            (label.Widget ap{"HTML Text"}, htmlWidget),
            (label.Widget ap{"Rendered"}, webWidget)
        ];
}
